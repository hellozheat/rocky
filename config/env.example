# MCP devkit — copy to .env at repo root (never commit .env)

PORT=3737
MCP_URL=http://localhost:3737

# Logo: derived from MCP_URL host → https://{apex}/logo.jpg (e.g. devkit.zheat.xyz → https://zheat.xyz/logo.jpg)
# DEVKIT_LOGO_URL=https://zheat.xyz/logo.jpg
# DEVKIT_LOGO_APEX=zheat.xyz

# Handbook / server root if cwd is wrong
# DEVKIT_HANDBOOK_ROOT=/absolute/path/to/mcp-devkit

# Comma-separated allowed roots for repo + dev tools
# DEVKIT_ALLOWED_REPO_ROOTS=/path/to/your/repos

# Open PR via GitHub API (repo_open_pr / devkit action)
# GITHUB_TOKEN=ghp_...

# Optional: pin Node 20+ if your default node is older
# DEVKIT_NODE_BIN=/path/to/node
